{
  "name": "dsh-date-model",
  "version": "0.1.0",
  "description": "按日期 + 天气挑一个假模型名（无限数字滚轮 + 月历），并把选中的名字写进系统提示词：问「你是谁」就回答它。不是真的模型选择器。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "docs",
    "scripts"
  ],
  "license": "MIT",
  "author": "dynasturn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynasturnStudio/dsh-date-model.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "date-model",
    "playground"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:host": "node scripts/host-check.mjs",
    "check:all": "node scripts/check.mjs && node scripts/host-check.mjs"
  }
}
